# Copy to .env (dev) – `docker-compose.dev.yml`, the API and Vite all read it.

# --- Postgres -------------------------------------------------------------
DATABASE_URL=postgres://freezer:freezer@localhost:5432/freezer
# prod only (docker-compose.yml)
POSTGRES_PASSWORD=change-me

# --- API / Better Auth ----------------------------------------------------
API_PORT=3000
# Public origin of the web app (Better Auth base URL; /api is proxied to the API)
WEB_ORIGIN=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# prod only: parent domain so sync.<domain> receives the session cookie
COOKIE_DOMAIN=

# --- Pocket ID ------------------------------------------------------------
POCKET_ID_URL=http://localhost:1411
# true when Pocket ID sits behind a proxy (e.g. tailscale serve, see README)
POCKET_ID_TRUST_PROXY=false
# Optional: how the API reaches Pocket ID if different from the public URL
POCKET_ID_INTERNAL_URL=
# Administration → OIDC Clients (confidential); callback: <WEB_ORIGIN>/api/auth/callback/pocket-id
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
# Administration → API Keys (used to create signup links for invites; optional)
POCKET_ID_API_KEY=
# Optional: Pocket ID group IDs (comma-separated) that people signing up via an invite join
POCKET_ID_SIGNUP_GROUP_IDS=
# Optional: registration code shown nowhere; people who know it can create an account on the
# login page (needs POCKET_ID_API_KEY). Empty = invite-only. E.g. three random words.
REGISTRATION_CODE=
# openssl rand -base64 32 (dev pocket-id container; in production only with the bundled-pocket-id profile)
POCKET_ID_ENCRYPTION_KEY=

# --- Zero -----------------------------------------------------------------
# Shared secret zero-cache sends to /api/zero/* (openssl rand -hex 32)
ZERO_API_KEY=
# prod only: zero-cache admin password (openssl rand -hex 16)
ZERO_ADMIN_PASSWORD=

# --- Web (Vite, baked in at build time) -----------------------------------
VITE_ZERO_CACHE_URL=http://localhost:4848
# Origin printed into container QR stickers (use the prod URL so stickers work there)
VITE_PUBLIC_URL=https://freezer.malte-nowatzky.de

# --- Production images (docker-compose.yml) -------------------------------
# Docker Hub repository and tag of the api/web images (tags: api-<IMAGE_TAG>, web-<IMAGE_TAG>)
IMAGE_REPO=maltenow/freezer-manager
IMAGE_TAG=latest
# Production only: run Pocket ID inside the stack (otherwise POCKET_ID_URL points to an existing instance)
# COMPOSE_PROFILES=bundled-pocket-id
