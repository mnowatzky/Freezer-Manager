# Production: copy to .env next to docker-compose.yml (chmod 600) and fill in.
# See README → Self-hosting. Keep a backup of this file; losing the secrets logs everyone out
# (BETTER_AUTH_SECRET) or makes a bundled Pocket ID unusable (POCKET_ID_ENCRYPTION_KEY).

# --- Images -----------------------------------------------------------------
# Tags are api-<IMAGE_TAG> and web-<IMAGE_TAG>. Pin a release version (e.g. 0.1.0) instead of
# latest so updates and rollbacks are deliberate.
IMAGE_REPO=maltenow/freezer-manager
IMAGE_TAG=latest

# --- Hostnames (without https://) -------------------------------------------
# The app. SYNC_HOST must be a subdomain of FREEZER_HOST, so the session cookie reaches zero-cache.
FREEZER_HOST=freezer.example.com
SYNC_HOST=sync.freezer.example.com
# External Docker network shared with your reverse proxy
PROXY_NETWORK=npm_proxy

# --- Secrets ----------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32
ZERO_API_KEY=
# openssl rand -hex 16
ZERO_ADMIN_PASSWORD=

# --- Pocket ID ----------------------------------------------------------------
# Public URL of your Pocket ID instance
POCKET_ID_URL=https://id.example.com
# OIDC client (confidential, PKCE on), callback: https://<FREEZER_HOST>/api/auth/callback/pocket-id
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
# Admin API key; needed to create signup links for invites and registration
POCKET_ID_API_KEY=
# Optional: comma-separated group IDs that people signing up through the app join
POCKET_ID_SIGNUP_GROUP_IDS=
# Optional: code that lets people without an invite create an account on the login page.
# Empty = invite-only.
REGISTRATION_CODE=

# --- Optional: run Pocket ID inside this stack ----------------------------------
# COMPOSE_PROFILES=bundled-pocket-id
# POCKET_ID_INTERNAL_URL=http://pocket-id:1411
# openssl rand -base64 32
# POCKET_ID_ENCRYPTION_KEY=
