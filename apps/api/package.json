{
  "name": "@freezer/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/migrate.ts && tsx src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@freezer/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@rocicorp/zero": "1.10.0",
    "better-auth": "1.7.8",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
